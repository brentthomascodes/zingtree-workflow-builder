flowchart TD
    %% Corpay UK (Allstar) Email Automation - INT (tree 783808640) - v4 2026-09-10
    classDef data fill:#dbeafe,stroke:#1d4ed8,color:#0f172a
    classDef ai fill:#ede9fe,stroke:#6d28d9,color:#0f172a
    classDef script fill:#fef3c7,stroke:#b45309,color:#0f172a
    classDef router fill:#fee2e2,stroke:#b91c1c,color:#0f172a
    classDef content fill:#dcfce7,stroke:#15803d,color:#0f172a
    classDef email fill:#fce7f3,stroke:#be185d,color:#0f172a
    classDef test fill:#f1f5f9,stroke:#64748b,stroke-dasharray:4 3,color:#0f172a

    N1["1 Start"]:::content
    N2[("2 Get case + inbound email<br/>sfdc_int__case_email_ai")]:::data
    N3{"3 Account linked?"}:::router
    N4["4 No account linked"]:::content
    N5[("5 Get account details<br/>get_account_details__int")]:::data
    N6["6 Check AI eligibility<br/>+ Phase 1 bypass gate"]:::script
    N7{"7 Account AI eligible?"}:::router
    N8["8 Account not eligible"]:::content
    N9[["9 Detect email intent<br/>automate_email_intent_int"]]:::ai
    N10["10 Grade intent result<br/>email_analysis_route"]:::script
    N11{"11 Email analysis route"}:::router
    N12["12 Build escalation notice"]:::script
    N13["13 Escalation notice"]:::content
    N14["14 Case is not automated"]:::content
    N15["15 Set case origin"]:::script
    N16[["16 Generate email response<br/>automate_email_generation_int"]]:::ai
    N17["17 Build case review dashboard"]:::script
    N18["18 Case review dashboard"]:::content
    N19{"19 Multiple intents?"}:::router
    N20["20 Choose the Sub Topic"]:::content
    N21["21 Make manual changes"]:::content
    N22{"22 Mock mode?"}:::router
    N23[("23 Get incoming email addresses<br/>get_incoming_email_addresses_int")]:::data
    N24["24 Build email payload"]:::script
    N25{"25 Mock mode before send?"}:::router
    N26[("26 Send email to customer<br/>send_email_simple_int")]:::data
    N27["27 Grade email send"]:::script
    N28{"28 Email sent?"}:::router
    N29["29 Email sent"]:::content
    N30["30 Notify team of failed send"]:::email
    N31["31 Email to customer failed"]:::content
    N32["32 Test mode - pick a scenario"]:::test
    N33["33 Load example email"]:::test
    N34["34 Test mode - review / edit email"]:::test
    N35["35 Seed mocked Salesforce data"]:::test

    N1 -->|Process this case| N2
    N1 -->|Test Mode QA| N32
    N2 --> N3
    N3 -->|"mock == 1"| N6
    N3 -->|AccountId present| N5
    N3 -->|else| N4
    N4 -->|try again| N2
    N5 --> N6 --> N7
    N7 -->|true| N9
    N7 -->|false| N8
    N9 --> N10 --> N11
    N11 -->|escalation| N12 --> N13
    N11 -->|in_scope| N15
    N11 -->|else| N14
    N15 --> N16 --> N17 --> N18
    N18 -->|Yes - send| N19
    N18 -->|No - manual| N21
    N19 -->|multiple| N20
    N19 -->|"mock == 1"| N24
    N19 -->|else| N23
    N20 -->|Send| N22
    N20 -->|Manual| N21
    N21 -->|Send + update| N22
    N22 -->|"mock == 1"| N24
    N22 -->|else| N23
    N23 --> N24 --> N25
    N25 -->|"mock == 1"| N27
    N25 -->|else| N26
    N26 --> N27 --> N28
    N28 -->|true| N29
    N28 -->|else| N30 --> N31
    N32 --> N33 --> N34 --> N35 --> N3
