        n83 --> n82 --> n85 --> n86 --> n49 --> nSTG --> n80 --> n81 --> n1 --> n2 --> n12 --> n25 --> n27 --> n84 --> n79
    end

    parent3["Parent tree · node 3<br/>any child tickets?"]
    parent32["Parent tree · node 32<br/>Loop Child Tickets<br/>reads child_ticket.passengers"]
    parent21["Parent tree · node 21<br/>Format Internal Note<br/>reads record.passengers"]
    parent44["Parent tree · node 44<br/>Loop Errands to Register<br/>reads rec.passengers"]

    n79 -.->|"return_tree_node_id 3"| parent3
    parent3 --> parent32
    parent3 --> parent21
    parent21 --> parent44

    classDef new fill:#dce8df,stroke:#2f6f4f,stroke-width:2px;
    classDef changed fill:#f3eadb,stroke:#9a6a1a,stroke-width:2px;
    classDef parent fill:#f5f5f5,stroke:#9ca3af,stroke-dasharray: 4 3;
    class n85,n86 new;
    class n27,n84 changed;
    class parent3,parent32,parent21,parent44 parent;
