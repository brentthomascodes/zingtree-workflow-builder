%% Post Collection Flow (173598167) — node 910 split, 2026-07-28
%% Current (v2): one 16-field mega-node vs New (v3): 5 sequential screens + 1 branch

flowchart TB
    subgraph CURRENT["CURRENT (v2) — Brent's 'wall of text'"]
        direction TB
        C910["Content 910 (root)\n16 heterogeneous fields:\nID, times, specimen, BAT,\nDER (same-screen conditional),\npaperwork — all on one screen"]
        C913["Script 913\nSF time conversion"]
        C911["Data 911\nUpdate SF Event (CO 447)"]
        C912["Content 912\nSuccess screen"]
        C910 -->|Submit| C913 --> C911 --> C912
    end

    subgraph NEW["NEW (v3) — 5 sequential screens + one real branch"]
        direction TB
        N910["Content 910 (root) — ID UNCHANGED\nCollection Timing\nsf_Id (read-only), arrival, end"]
        N1["Content 1\nSpecimen & Chain of Custody\nCCF#, ATF#, FedEx#, Test#"]
        N2["Content 2\nBreath Alcohol Test (BAT)\ntime, zone, printout#, result,\nBAT positive?"]
        N3["Script 3\nEvaluate BAT Result\nsets bat_is_positive"]
        N4{{"Scoring 4\nBAT Positive? Routing\nadvanced_logic_node=1"}}
        N5["Content 5\nDER Notification\n(reached only if positive)\nfields now plain, unconditional"]
        N6["Content 6\nPaperwork & Closeout\nupload, sent-to-Delta?"]
        N913b["Script 913\nSF time conversion (unchanged,\nnow also converts BAT time)"]
        N911b["Data 911\nUpdate SF Event (CO 447)\nUNCHANGED"]
        N912b["Content 912\nSuccess screen — UNCHANGED"]

        N910 -->|Continue| N1 -->|Continue| N2 -->|Continue| N3
        N3 --> N4
        N4 -->|"bat_is_positive == true"| N5
        N4 -->|"bat_is_positive == false\n(+ continuation fallback)"| N6
        N5 -->|Continue| N6
        N6 -->|Submit| N913b --> N911b --> N912b
    end

    Delta["Delta tree 683028422\nnode 17 (OSM email)\ndeep-link: .../173598167?zv_sf_Id=...#910"] -.->|"still resolves to a real,\nsensible first screen"| N910

    style C910 fill:#fef2f2,stroke:#fecaca
    style N910 fill:#eef2ff,stroke:#c7d2fe
    style N4 fill:#fff7ed,stroke:#fed7aa
