    N10 --> N4 --> N6 --> N24 --> N7 --> N8 --> N9 --> N42 --> N46 --> N1 --> N2 --> N11
    N11 -- "more PNRs" --> N7
    N11 -- "done" --> N12 --> N25 --> N27 --> N3
    N3 -- "child_tickets >= 1" --> N32
    N3 -- "none" --> N21
    N32 --> N33 --> N35
    N35 -- "yes" --> N39 --> N41 --> N40 --> N36 --> N37 --> N38
    N38 -- "more" --> N36
    N38 -- "done" --> N34
    N35 -- "no" --> N34
    N34 -- "more" --> N32
    N34 -- "done" --> N21
    N21 --> N22 --> N44 --> N43 --> N45
    N45 -- "more" --> N44
    N45 -- "done" --> N23
    N23 -- "Additional Request" --> N47 --> N29
    N23 -- "Different Request (NEW)" --> N49 --> N29
    N23 -- "End Session" --> N48
