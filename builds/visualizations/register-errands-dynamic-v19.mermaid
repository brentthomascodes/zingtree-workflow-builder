flowchart TD
    classDef script fill:#eef2ff,stroke:#6366f1,stroke-width:1px,color:#1e1b4b
    classDef content fill:#f9fafb,stroke:#9ca3af,color:#111827
    classDef logic fill:#fff7ed,stroke:#f59e0b,color:#78350f
    classDef api fill:#ecfdf5,stroke:#10b981,color:#064e3b
    classDef changed fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d

