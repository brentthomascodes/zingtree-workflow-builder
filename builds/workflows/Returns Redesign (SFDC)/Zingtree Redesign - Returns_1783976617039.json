able.push(record);\n      }\n\n      \/\/ Non-Returnable Bucket -> Outside of Policy (30 days)\n      if (\n        ((record.Order_Line_Item_Status__c == \"Shipped\"\n          || record.Order_Line_Item_Status__c == \"Delivered\")\n        && record.Item_Returnable__c == false)\n        || ZT.isOlderThan30Days(record.Delivered_Date__c)) {\n        buckets.non_returnable.push(record);\n      }\n\n      \/\/ Not Shipped Bucket\n      \/\/ Has not shipped yet, has to be canceled\n      if ((record.Order_Line_Item_Status__c === \"Back Order\"\n        || record.Order_Line_Item_Status__c === \"Open\"\n        || record.Order_Line_Item_Status__c === \"Cancelled\")) {\n          buckets.not_shipped.push(record);\n      } \n  });\n  return buckets;\n}\n\nlet buckets = bucketRecords(records);\nZT.setTransformData(\"buckets\", buckets);\n\/\/ Not Shipped Dynamic View\nZT.setResponseData(\"dynamic_view__not_shipped\", { records: buckets.not_shipped });\n\/\/ Returnable Dynamic View\nZT.setResponseData(\"dynamic_view__returnable\", { records: buckets.returnable });\n\/\/ Non Returnable Dynamic View\nZT.setResponseData(\"dynamic_view__non_returnable\", { records: [...buckets.non_returnable] });","question":"","keywords":"","confirmation_text":"","notes":"","project_node_id":"3","score_var":"","x":"-1","y":"0","width":"150","height":"75","level":"0","buttons_across":"0","resolution_state":"?","hide_back_restart":"0","hide_persistent_buttons":"0","hide_from_search":"0","repeat_form":"1","form_columns":"1","email":"","email_bcc":"","email_return_url":"","email_subject":"","email_preheader":"","email_reply_to":"","email_sender_name":"","email_body":"","email_send_now":"0","email_include_session_data":"1","email_data_privacy":"0","link":"","link_new_tab":"0","link_direct":"1","open_tree_id":"0","open_tree_node_id":"0","return_tree_node_id":"0","randomize_scoring":"0","advanced_logic_node":"0","tag":"","jsmessage":"","value":"1","probability":"500","updated":"0","display_order":"3","s