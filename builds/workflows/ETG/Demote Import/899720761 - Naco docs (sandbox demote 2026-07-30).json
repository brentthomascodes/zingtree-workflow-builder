    "3": {
      "type": "Script",
      "is_root": "0",
      "node_name": "",
      "page_title": "Child Ticket Script",
      "content": "let current_pnr_bucket = transforms.current_pnr_bucket;\n\nlet selected_pnrs_final = transforms.selected_pnrs_final || [];\ncurrent_pnr_bucket.forEach(pnr => {\n    selected_pnrs_final.push(pnr);\n})\n\nZT.setTransformData(\"selected_pnrs_final\", selected_pnrs_final)\n\n// PNR Loop\nlet current_pnr_bucket_index = transforms.current_pnr_bucket_index || 0;\nlet current_pnr_in_bucket = current_pnr_bucket[current_pnr_bucket_index];\nlet isMorePNR_InBucket = false;\n\ncurrent_pnr_bucket_index += 1;\nif (current_pnr_bucket_index < current_pnr_bucket.length) {\n    isMorePNR_InBucket = true;\n} else {\n    current_pnr_bucket_index = 0;\n}\n\nZT.setTransformData(\"current_pnr_bucket_index\", current_pnr_bucket_index)\nZT.setTransformData(\"current_pnr_in_bucket\", current_pnr_in_bucket);\nZT.setTransformData(\"isMorePNR_InBucket\", isMorePNR_InBucket)\n\n// CHILD TICKET\nlet child_ticket = {\n    subject: `Child ${current_pnr_in_bucket.pnr} - Name Correction and Change`,\n    body: `${current_pnr_in_bucket.proceedHandling}` // Tree Name (GDPR Docs, Flexible Payment, etc),\n}\n\nZT.setTransformData(\"child_ticket\", child_ticket);",
      "question": "",
