    "3": {
      "type": "Script",
      "is_root": "0",
      "node_name": "Grades the status code and renders the raw response",
      "page_title": "Grade the BizPay call",
      "content": "let response = actions.bizpay__get_payments;\nlet code = response._zt_meta.response.code;\nlet connected = code >= 200 && code < 300;\nlet payments = connected ? response.payments : [];\nlet rows = payments.map(p => `<tr><td>${p.payment_id}</td><td>${p.client_id}</td><td>${p.vendor_id}</td><td>${p.client_vendor_id}</td><td>${p.payment_amount}</td><td>${p.fee}</td></tr>`).join(\"\");\nlet table = `<table><tr><th>Payment ID</th><th>Client ID</th><th>Vendor ID</th><th>Client Vendor ID</th><th>Amount</th><th>Fee</th></tr>${rows}</table>`;\nlet errorBody = connected ? \"\" : String(response._zt_meta.response.body || \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\");\nlet html = connected\n  ? `<p><strong>Connected.</strong> BizPay returned HTTP ${code} with ${payments.length} payment(s).</p>${table}`\n  : `<p><strong>Not connected.</strong> BizPay returned HTTP ${code}. A 401 or 403 points at the data source credentials or audience; a timeout points at the IP whitelist.</p><pre style=\"white-space:pre-wrap\">${errorBody}</pre>`;\nZT.setTransformData(\"bizpay_result_html\", html.replace(/\\n/g, \" \"));",
      "question": "",
      "keywords": "",
      "confirmation_text": "",
      "notes": "",
